    "sqlite",
    "jwt",
    "uni-app"
  ],
  "author": "CharLene",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  },
  "engines": {
    "node": ">=18"
  }
