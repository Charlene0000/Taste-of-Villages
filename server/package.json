{
  "name": "taste-of-the-village-server",
  "version": "1.0.0",
  "description": "舌尖上的村落后端 —— Express + Prisma + SQLite，纯本地零配置运行",
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "db:push": "prisma db push",
