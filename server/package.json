    "db:reset": "prisma db push --force-reset",
    "db:studio": "prisma studio",
    "test": "node tests/run-tests.js",
    "test:api": "node tests/api.test.js",
    "test:unit": "node tests/cache-pagination.test.js"
  },
  "keywords": [
    "express",
