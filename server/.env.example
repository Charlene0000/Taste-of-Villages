# ===== 复制本文件为 .env 后按需填写 =====
# cp .env.example .env

# 服务端口
PORT=3000

# SQLite 数据库文件路径（相对 server/ 目录）
DATABASE_URL="file:./dev.db"

# JWT 签名密钥 —— 必须替换
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-placeholder-at-least-32-chars

# JWT 有效期（秒），默认 7 天
JWT_EXPIRES_IN=604800

# 开发模式：true 时 /api/auth/send-code 在响应中返回 devCode，不真实发短信
# ⚠️ 生产环境必须为 false
DEV_MODE=false

# 前端跨域允许来源（逗号分隔，* 表示全部）
CORS_ORIGIN=*

# ===== 可选外部服务（默认全部关闭，零配置可跑）=====

# DeepSeek LLM（收费）：https://platform.deepseek.com/api_keys
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=your-deepseek-key-placeholder
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# 讯飞 TTS（收费）：https://www.xfyun.cn/console/tts/voicelist
XFYUN_ENABLED=false
XFYUN_APP_ID=your-xfyun-appid-placeholder
XFYUN_API_SECRET=your-xfyun-api-secret-placeholder
XFYUN_API_KEY=your-xfyun-api-key-placeholder

# 文件上传目录（相对 server/ 目录）
UPLOAD_DIR=uploads
