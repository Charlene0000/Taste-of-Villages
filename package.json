{
    "id": "taste-of-the-village-miniapp",
    "name": "taste-of-the-village",
    "version": "1.0.0",
    "description": "舌尖上的村落 · 乡村文旅美食打卡应用。基于 uni-app + Express，含自研 Agent 编排层与 Canvas 2D 数字人交互层。",
    "main": "main.js",
    "scripts": {
        "test": "node scripts/check-json.js && node scripts/check-frontend-refs.js && node scripts/check-vue-syntax.js && node scripts/check-template-tags.js",
        "test:agent": "node agent/tests/run-tests.js",
        "test:avatar": "node digital-avatar/tests/run-tests.js",
        "test:api": "node server/tests/api.test.js",
        "test:normalizer": "node utils/tests/normalizer.test.js",
        "test:contract": "node utils/tests/api-contract.test.js",
        "test:list": "node utils/tests/list-loader.test.js",
        "test:all": "node scripts/check-json.js && node scripts/check-frontend-refs.js && node scripts/check-vue-syntax.js && node scripts/check-template-tags.js && node agent/tests/run-tests.js && node digital-avatar/tests/run-tests.js && node utils/tests/normalizer.test.js && node utils/tests/list-loader.test.js",
        "server:dev": "cd server && npm run dev",
        "server:test": "cd server && npm run test:api",
        "server:seed": "cd server && node scripts/seed.js",
        "db:push": "cd server && npx prisma db push"
    },
    "keywords": [
        "uni-app",
        "uniCloud",
        "小程序",
        "乡村美食",
        "打卡",
        "AI Agent"
    ],
    "author": "CharLene",
    "license": "MIT",
    "dependencies": {
        "crypto-js": "^4.2.0",
        "echarts": "^6.0.0",
        "mpvue-echarts": "^1.0.0"
    },
    "displayName": "舌尖上的村落",
    "dcloudext": {
        "category": [
            "uni-app前端模板",
            "uni-app前端项目模板"
        ]
    },
    "engines": {
        "HBuilderX": "^3.8.5"
    },
    "directories": {
        "example": "../../temps/example_temps"
    },
    "uni_modules": {
        "platforms": {
            "client": {
                "App": {
                    "app-vue": "y",
                    "app-nvue": "n"
                },
                "H5-mobile": {
                    "Safari": "y",
                    "Android Browser": "y",
                    "微信浏览器(Android)": "y",
                    "QQ浏览器(Android)": "y"
                },
                "H5-pc": {
                    "Chrome": "y",
