{
    "id": "cross-border-symbiosis-miniapp",
    "name": "跨境共生小程序",
    "version": "1.0.0",
    "description": "跨境共生 · 乡村美食打卡小程序。基于 uni-app + uniCloud，含 AI 美食向导「饼饼」与自研 Agent 编排层、数字人交互层。",
    "main": "main.js",
    "scripts": {
        "test": "node scripts/check-json.js",
        "test:agent": "node agent/tests/run-tests.js",
        "test:avatar": "node digital-avatar/tests/run-tests.js",
        "test:api": "node server/tests/api.test.js",
        "test:all": "node scripts/check-json.js && node agent/tests/run-tests.js && node digital-avatar/tests/run-tests.js",
        "server:dev": "cd server && npm run dev",
        "server:test": "cd server && npm run test:api",
        "db:push": "cd server && npx prisma db push"
    },
    "keywords": [
        "uni-app",
        "uniCloud",
        "小程序",
        "乡村美食",
        "打卡",
        "AI Agent"
    ],
    "author": "CharLene",
    "license": "MIT",
    "dependencies": {
        "crypto-js": "^4.2.0",
        "echarts": "^6.0.0",
        "mpvue-echarts": "^1.0.0"
    },
    "displayName": "跨境共生小程序",
    "dcloudext": {
        "category": [
            "uni-app前端模板",
            "uni-app前端项目模板"
        ]
    },
    "engines": {
        "HBuilderX": "^3.8.5"
    },
    "directories": {
        "example": "../../temps/example_temps"
    },
    "uni_modules": {
        "platforms": {
            "client": {
                "App": {
                    "app-vue": "y",
                    "app-nvue": "n"
                },
                "H5-mobile": {
                    "Safari": "y",
                    "Android Browser": "y",
                    "微信浏览器(Android)": "y",
                    "QQ浏览器(Android)": "y"
                },
                "H5-pc": {
                    "Chrome": "y",
                    "IE": "y",
                    "Edge": "y",
                    "Firefox": "y",
                    "Safari": "y"
                },
                "小程序": {
                    "微信": "y",
                    "阿里": "u",
                    "百度": "u",
                    "字节跳动": "u",
                    "QQ": "u"
                },
                "快应用": {
                    "华为": "u",
                    "联盟": "u"
                },
                "Vue": {
                    "vue2": "y",
                    "vue3": "y"
                }
            }
        }
    }
}
